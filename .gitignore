# Python / PyInstaller / runtime — never commit these
__pycache__/
*.pyc
*.pyo
dist/
build/
.venv/
venv/

# Oracle runtime data, created on first run on a Mac (or by the agent)
workspace/
credentials/
logs/
# Local face profiles (faces/<name>/profile.json + crops + vectors)
# and voice identities — personal biometric data, NEVER committed.
faces/
identities/
alerts/

# Bundled API key (oracle-key.env) — injected only into a private
# copy of the app, NEVER committed, NEVER in a GitHub release.
oracle-key.env

# macOS
.DS_Store
